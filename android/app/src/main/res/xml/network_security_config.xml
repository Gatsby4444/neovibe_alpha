<?xml version="1.0" encoding="utf-8"?>
<!--
  Politique réseau de NeoVibe.

  Depuis Android 9 (API 28), le trafic HTTP en clair est REFUSÉ par défaut. Ce
  fichier ne lève cette interdiction que pour la BOUCLE LOCALE, où le serveur
  de médias déchiffre les vidéos bloc par bloc pour le lecteur
  (`MediaStreamServer`, v0.9.54). Sans cette exception, le lecteur ne peut pas
  joindre `http://127.0.0.1` et la vidéo ne démarre jamais.

  Pourquoi PAS `android:usesCleartextTraffic="true"` : cet attribut autorise le
  clair vers N'IMPORTE QUEL hôte, y compris Internet. Ce serait ouvrir tout le
  réseau pour un besoin qui tient à une seule adresse. La règle du projet est
  de séparer ce qui n'obéit pas aux mêmes règles : la boucle locale n'est pas
  le réseau.

  Ce que l'exception n'affaiblit pas : les octets servis sur 127.0.0.1 ne
  quittent jamais l'appareil, et aucune autre machine ne peut joindre cette
  adresse. Le trafic vers Supabase reste en HTTPS obligatoire.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
