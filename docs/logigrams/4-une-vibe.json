{
  "name": "NeoVibe — 4. Une Vibe, de la capture au partage",
  "nodes": [
    {
      "id": "intro4",
      "type": "note",
      "label": "La règle : 1 contenu = 1 contexte",
      "desc": "Une Vibe part vers UN seul endroit. Ce n'est pas une limite technique : c'est ce qui empêche un contenu d'échapper aux règles qu'on lui a données."
    },
    {
      "id": "capture",
      "type": "client",
      "label": "Écran de capture",
