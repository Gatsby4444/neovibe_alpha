        {
          "id": "t_choix",
          "type": "condition",
          "label": "quel type de Vibe ?"
        },
        {
          "id": "t_std",
          "type": "action",
          "label": "Standard",
          "desc": "une ou deux faces, le verso est facultatif"
        },
        {
          "id": "t_one",
          "type": "action",
          "label": "Oneshot",
          "desc": "avant et arrière d'un seul déclenchement, aucun outil"
        },
        {
          "id": "t_be",
          "type": "action",
          "label": "BeReal",
          "desc": "déclenché par notification, sans retouche"
        },
        {
          "id": "v_faces",
