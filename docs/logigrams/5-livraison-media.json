{
  "name": "NeoVibe — 5. Comment un média arrive à l'écran",
  "nodes": [
    {
      "id": "intro5",
      "type": "note",
      "label": "Deux barrières, pas une",
      "desc": "Avoir les octets ne suffit pas : ils sont chiffrés. Avoir la clé ne suffit pas : il faut aussi les octets. Le serveur ne donne la clé qu'à celui qui y a droit — et il en profite pour compter la vue."
    },
    {
      "id": "ecran5",
      "type": "client",
      "label": "Visionneuse",
      "children": [
        {
          "id": "ouvre",
          "type": "trigger",
          "label": "l'utilisateur ouvre une Vibe"
        }
      ]
    },
    {
      "id": "c_cache",
      "type": "condition",
      "label": "déjà téléchargé ?"
    },
    {
      "id": "cache",
      "type": "cache",
      "label": "Cache local",
      "children": [
        {
          "id": "v_blocs",
          "type": "variable",
          "label": "blocs déjà là",
          "dtype": "array"
        }
      ]
    },
    {
      "id": "srv5",
      "type": "cluster",
      "label": "Serveur",
      "children": [
        {
          "id": "rpc5",
          "type": "api",
          "label": "open_card_media",
          "desc": "vérifie le droit, DÉCOMPTE une vue et rend la clé — en une seule opération indivisible"
        },
        {
          "id": "c_droit",
          "type": "condition",
          "label": "a-t-il le droit ?"
        },
        {
          "id": "c_reste",
          "type": "condition",
          "label": "reste-t-il des vues ?"
        },
        {
          "id": "t_keys",
          "type": "table",
          "label": "clé du média"
        },
        {
          "id": "url",
          "type": "action",
          "label": "URL signée, valable quelques minutes"
        },
        {
          "id": "coffre5",
          "type": "storage",
          "label": "coffre"
        },
        {
          "id": "refus5",
          "type": "error",
          "label": "refusé"
        }
      ]
    },
    {
      "id": "dl",
      "type": "action",
      "label": "télécharger par tranches",
      "desc": "juste ce qu'il faut pour commencer à lire"
    },
    {
      "id": "natif5",
      "type": "container",
      "label": "Lecteur natif (Kotlin)",
      "children": [
        {
          "id": "dechiffre",
          "type": "transform",
          "label": "déchiffrer bloc par bloc",
          "desc": "en mémoire, à la volée"
        },
        {
          "id": "lecture",
          "type": "action",
          "label": "afficher / lire la vidéo"
        }
      ]
    },
    {
      "id": "jamais",
      "type": "note",
      "label": "Jamais de clair sur le disque",
      "desc": "« Ce qui se passe sur NeoVibe reste sur NeoVibe ». Un fichier déchiffré écrit sur le téléphone serait une promesse rompue."
    },
    {
      "id": "vue",
      "type": "trigger",
      "label": "après 3 secondes à l'écran",
      "desc": "c'est là qu'on dit au serveur « il l'a vraiment vue »"
    },
    {
      "id": "t_views",
      "type": "table",
      "label": "content_views"
    }
  ],
